# Plantilla de los "secrets" de Streamlit (NO pongas aquí las claves reales: van en la web de Streamlit Cloud,
# en Settings -> Secrets). Este archivo solo muestra los nombres.
SUPABASE_URL = "https://TU-PROYECTO.supabase.co"
SUPABASE_KEY = "la clave service_role de Supabase (Project Settings -> API Keys)"
SUPERADMIN_EMAIL = "tu-correo@gmail.com"
TELEGRAM_TOKEN = "la clave de tu bot"
TELEGRAM_CHAT_ID = "tu número de chat"

[auth]
redirect_uri = "https://TU-APP.streamlit.app/oauth2callback"
cookie_secret = "una frase larga inventada, de al menos 32 letras"

[auth.google]
client_id = "....apps.googleusercontent.com"
client_secret = "la clave secreta del cliente de Google"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
